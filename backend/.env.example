# ---------- Application ----------
NODE_ENV=development
PORT=3000
# Public URL where this backend is reachable (used to build OAuth callback / webhook URLs).
# For Shopify webhooks in local dev, expose the backend with a tunnel (e.g. cloudflared / ngrok) and put that URL here.
APP_URL=http://localhost:3000
# Frontend origin (CORS + post-OAuth redirect).
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---------- Database ----------
DATABASE_URL=postgresql://crm:crm@localhost:5432/mini_crm?schema=public

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
# 32-byte key, base64 encoded, used to encrypt Shopify access tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# ---------- Shopify ----------
SHOPIFY_API_KEY=your-shopify-client-id
SHOPIFY_API_SECRET=your-shopify-client-secret
SHOPIFY_API_VERSION=2026-10
SHOPIFY_SCOPES=read_orders,write_orders,read_products,read_customers
# Defaults to ${APP_URL}/api/shopify/callback when empty
SHOPIFY_CALLBACK_URL=
# HMAC signing secret for webhooks. For apps installed via OAuth this is the app's client secret.
# Defaults to SHOPIFY_API_SECRET when empty.
SHOPIFY_WEBHOOK_SECRET=
# Base URL Shopify will POST webhooks to. Defaults to APP_URL when empty.
SHOPIFY_WEBHOOK_BASE_URL=
SHOPIFY_REQUEST_TIMEOUT_MS=15000
SHOPIFY_MAX_RETRIES=4

# ---------- Webhook processing ----------
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_INTERVAL_MS=30000
