// Mini Order Management CRM – PostgreSQL schema
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  ADMIN
  USER
}

enum StoreConnectionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  INVALID_TOKEN
  ERROR
}

enum SyncType {
  IMPORT
  SYNC
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum OrderSource {
  SHOPIFY_IMPORT
  CRM
  WEBHOOK
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum OrderCreationStatus {
  PENDING // request accepted locally, Shopify call in flight
  SUCCEEDED // Shopify confirmed + persisted locally
  FAILED // Shopify definitively rejected the request
  UNKNOWN // outcome uncertain (timeout / network) – needs reconciliation
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED
}

// ───────────────────────────── Auth ─────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connectedStores       ShopifyStore[]
  oauthStates           OAuthState[]
  syncRuns              SyncRun[]
  orderCreationRequests OrderCreationRequest[]
}

/// Revoked JWTs (logout). Rows can be purged once expiresAt has passed.
model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ───────────────────────────── Shopify ─────────────────────────────

/// Short-lived OAuth "state" nonce binding a Shopify install to a CRM user.
model OAuthState {
  id         String   @id @default(uuid()) @db.Uuid
  state      String   @unique
  shopDomain String
  userId     String   @db.Uuid
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShopifyStore {
  id                   String                @id @default(uuid()) @db.Uuid
  shopDomain           String                @unique
  /// Shopify Shop GID, e.g. gid://shopify/Shop/123
  shopifyStoreId       String?               @unique
  name                 String?
  currency             String?               @db.VarChar(3)
  /// AES-256-GCM encrypted offline access token (never returned by the API)
  accessToken          String?
  scopes               String?
  connectionStatus     StoreConnectionStatus @default(PENDING)
  lastError            String?
  lastSyncAt           DateTime?
  webhooksRegisteredAt DateTime?
  connectedById        String?               @db.Uuid
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  connectedBy           User?                  @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  customers             Customer[]
  orders                Order[]
  webhookEvents         WebhookEvent[]
  syncRuns              SyncRun[]
  orderCreationRequests OrderCreationRequest[]
}

model SyncRun {
  id            String     @id @default(uuid()) @db.Uuid
  storeId       String     @db.Uuid
  type          SyncType
  status        SyncStatus @default(RUNNING)
  ordersFetched Int        @default(0)
  ordersCreated Int        @default(0)
  ordersUpdated Int        @default(0)
  ordersSkipped Int        @default(0)
  errorMessage  String?
  triggeredById String?    @db.Uuid
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?

  store       ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  triggeredBy User?        @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([storeId, startedAt])
  @@index([status])
}

// ───────────────────────────── CRM data ─────────────────────────────

model Customer {
  id                String   @id @default(uuid()) @db.Uuid
  storeId           String   @db.Uuid
  /// Shopify Customer GID
  shopifyCustomerId String
  name              String?
  firstName         String?
  lastName          String?
  email             String?
  phone             String?
  billingAddress    Json?
  shippingAddress   Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store  ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, shopifyCustomerId])
  @@index([email])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_name_trgm_idx")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  storeId           String      @db.Uuid
  /// Shopify Order GID, e.g. gid://shopify/Order/123
  shopifyOrderId    String
  /// Human readable order name, e.g. "#1001"
  orderNumber       String
  customerId        String?     @db.Uuid
  /// Denormalised for fast search / orders without a customer record
  customerName      String?
  email             String?
  phone             String?
  orderDate         DateTime
  orderStatus       OrderStatus @default(OPEN)
  fulfillmentStatus String?
  financialStatus   String?
  subtotal          Decimal     @default(0) @db.Decimal(18, 4)
  totalTax          Decimal     @default(0) @db.Decimal(18, 4)
  totalDiscount     Decimal     @default(0) @db.Decimal(18, 4)
  shippingAmount    Decimal     @default(0) @db.Decimal(18, 4)
  totalAmount       Decimal     @default(0) @db.Decimal(18, 4)
  currency          String      @db.VarChar(3)
  billingAddress    Json?
  shippingAddress   Json?
  note              String?
  tags              String[]    @default([])
  source            OrderSource
  cancelledAt       DateTime?
  closedAt          DateTime?
  /// Shopify's updated_at – used to ignore stale/out-of-order updates
  shopifyUpdatedAt  DateTime?
  lastSyncedAt      DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  store    ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@unique([storeId, shopifyOrderId])
  @@index([orderNumber])
  @@index([customerName])
  @@index([email])
  @@index([orderDate])
  @@index([totalAmount])
  @@index([orderStatus])
  @@index([fulfillmentStatus])
  @@index([financialStatus])
  @@index([orderNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_orderNumber_trgm_idx")
  @@index([customerName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Order_customerName_trgm_idx")
}

model OrderItem {
  id                String  @id @default(uuid()) @db.Uuid
  orderId           String  @db.Uuid
  /// Shopify LineItem GID
  shopifyLineItemId String
  shopifyProductId  String?
  shopifyVariantId  String?
  productName       String
  variantName       String?
  sku               String?
  quantity          Int
  unitPrice         Decimal @db.Decimal(18, 4)
  totalDiscount     Decimal @default(0) @db.Decimal(18, 4)
  totalPrice        Decimal @db.Decimal(18, 4)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, shopifyLineItemId])
  @@index([shopifyVariantId])
}

/// Tracks every CRM → Shopify order creation attempt for idempotency and reconciliation.
model OrderCreationRequest {
  id             String              @id @default(uuid()) @db.Uuid
  idempotencyKey String              @unique
  userId         String              @db.Uuid
  storeId        String              @db.Uuid
  status         OrderCreationStatus @default(PENDING)
  requestPayload Json
  /// SHA-256 of the request payload: re-using a key with a different payload is rejected
  payloadHash    String
  shopifyOrderId String?
  orderId        String?             @db.Uuid
  errorMessage   String?
  attempts       Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  store ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ───────────────────────────── Webhooks ─────────────────────────────

model WebhookEvent {
  id                   String                  @id @default(uuid()) @db.Uuid
  /// X-Shopify-Webhook-Id – unique per delivery, shared by retries (dedupe key)
  shopifyEventId       String
  /// X-Shopify-Event-Id – correlates deliveries of the same merchant action
  shopifyCorrelationId String?
  shopDomain           String
  storeId              String?                 @db.Uuid
  topic                String
  shopifyOrderId       String?
  apiVersion           String?
  processingStatus     WebhookProcessingStatus @default(RECEIVED)
  payload              Json
  receivedAt           DateTime                @default(now())
  triggeredAt          DateTime?
  processedAt          DateTime?
  retryCount           Int                     @default(0)
  nextRetryAt          DateTime?
  lockedAt             DateTime?
  errorMessage         String?

  store ShopifyStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([shopDomain, shopifyEventId])
  @@index([processingStatus, nextRetryAt])
  @@index([shopifyOrderId])
  @@index([topic])
  @@index([receivedAt])
}
