# Base URL of the backend REST API (including the /api prefix).
# Use a relative value together with VITE_DEV_PROXY_TARGET in development,
# or an absolute URL (e.g. https://api.example.com/api) in other environments.
VITE_API_BASE_URL=/api

# Development only: where the Vite dev server proxies /api requests.
VITE_DEV_PROXY_TARGET=http://localhost:3000
VITE_DEV_PORT=5173
